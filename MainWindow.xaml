<Window x:Class="WindowsDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:WindowsDashboard.Controls"
        Title="Windows 桌面整理器"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        WindowState="Maximized"
        Width="1920"
        Height="1080"
        FontFamily="Segoe UI">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid x:Name="RootGrid" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border x:Name="WindowBar"
            Grid.Row="0"
            Background="#F0252632"
            BorderBrush="#7A8294"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed">
      <Grid>
        <TextBlock Text="Windows 桌面整理器"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"
                   Margin="12,0"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
          <Button x:Name="SettingsButton"
                  Click="OnSettingsClick"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="{DynamicResource TextSecondaryBrush}"
                  FontFamily="Segoe MDL2 Assets"
                  FontSize="12"
                  Width="36"
                  Height="30"
                  Content="&#xE713;"
                  Cursor="Hand"
                  ToolTip="设置"/>
          <Button x:Name="MinButton"
                  Click="OnMinClick"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="{DynamicResource TextSecondaryBrush}"
                  FontFamily="Segoe MDL2 Assets"
                  FontSize="14"
                  Width="36"
                  Height="30"
                  Content="&#xE921;"
                  Cursor="Hand"
                  ToolTip="最小化"/>
          <Button x:Name="CloseButton"
                  Click="OnCloseClick"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="{DynamicResource TextSecondaryBrush}"
                  FontFamily="Segoe MDL2 Assets"
                  FontSize="14"
                  Width="36"
                  Height="30"
                  Content="&#xE8BB;"
                  Cursor="Hand"
                  ToolTip="隐藏到托盘"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="CardGrid"
          Grid.Row="1"
          Background="Transparent"
          SizeChanged="OnCardGridSizeChanged"/>

    <Border x:Name="WidgetShell"
            Grid.Row="1"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            CornerRadius="14"
            BorderThickness="1.5"
            BorderBrush="{DynamicResource CardBorderBrush}"
            Background="{DynamicResource CardBrush}">
      <Border.Effect>
        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="2" Opacity="0.36"/>
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="42"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Thumb x:Name="WidgetDragThumb"
                 Cursor="SizeAll"
                 DragDelta="OnWidgetDragDelta">
            <Thumb.Template>
              <ControlTemplate TargetType="Thumb">
                <Border Background="Transparent"/>
              </ControlTemplate>
            </Thumb.Template>
          </Thumb>
          <TextBlock Text="桌面小组件"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}"
                     VerticalAlignment="Center"
                     Margin="14,0,0,0"/>
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0">
            <Button Click="OnWidgetSettingsClick"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12"
                    Width="30"
                    Height="28"
                    Content="&#xE713;"
                    Cursor="Hand"
                    ToolTip="设置"/>
            <Button Click="OnWidgetExpandClick"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12"
                    Width="30"
                    Height="28"
                    Content="&#xE8A7;"
                    Cursor="Hand"
                    ToolTip="展开完整面板"/>
            <Button Click="OnWidgetHideClick"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12"
                    Width="30"
                    Height="28"
                    Content="&#xE8BB;"
                    Cursor="Hand"
                    ToolTip="隐藏到托盘"/>
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="10,6,10,12">
          <StackPanel>
            <Border x:Name="WidgetClockSection"
                    Background="#0DFFFFFF"
                    BorderBrush="#14FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,0,8">
              <controls:ClockCard x:Name="WidgetClock"/>
            </Border>
            <Border x:Name="WidgetQuickSection"
                    Background="#0DFFFFFF"
                    BorderBrush="#14FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8"
                    Margin="0,0,0,8">
              <controls:QuickToolsCard x:Name="WidgetQuick"/>
            </Border>
            <Border x:Name="WidgetMonitorSection"
                    Background="#0DFFFFFF"
                    BorderBrush="#14FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,0,8">
              <controls:SystemMonitorCard x:Name="WidgetMonitor"/>
            </Border>
            <Border x:Name="WidgetCalendarSection"
                    Background="#0DFFFFFF"
                    BorderBrush="#14FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8"
                    Margin="0,0,0,8">
              <controls:CalendarCard x:Name="WidgetCalendar"/>
            </Border>
            <Border x:Name="WidgetNotesSection"
                    Background="#0DFFFFFF"
                    BorderBrush="#14FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8"
                    Margin="0,0,0,8">
              <controls:StickyNoteCard x:Name="WidgetNotes"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>
