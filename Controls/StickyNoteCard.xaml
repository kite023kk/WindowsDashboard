<UserControl x:Class="WindowsDashboard.Controls.StickyNoteCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="NotesList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#8A403B1E"
                    BorderBrush="#24D5BD7A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,2,0,6"
                    Padding="8,8,30,8">
              <Grid>
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#ECE4C8"
                         FontSize="12"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="54"
                         VerticalScrollBarVisibility="Auto"
                         CaretBrush="#ECE4C8"/>
                <Button Tag="{Binding}"
                        Click="OnDelete"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-4,-22,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#73ECE4C8"
                        FontSize="13"
                        Content="×"
                        Cursor="Hand"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Button x:Name="AddButton"
            Grid.Row="1"
            Click="OnAdd"
            HorizontalAlignment="Left"
            Background="Transparent"
            BorderThickness="0"
            Foreground="{DynamicResource TextMutedBrush}"
            FontSize="11"
            Padding="6,4"
            Content="+ 添加便签"
            Margin="2,4,0,0"
            Cursor="Hand"/>
  </Grid>
</UserControl>
