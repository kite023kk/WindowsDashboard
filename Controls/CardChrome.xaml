<UserControl x:Class="WindowsDashboard.Controls.CardChrome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
  <Border x:Name="RootBorder"
          CornerRadius="12"
          BorderThickness="2"
          BorderBrush="{DynamicResource CardBorderBrush}"
          Background="Transparent">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="2" Opacity="0.32"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border x:Name="Backdrop"
              CornerRadius="11"
              Margin="1"
              Background="{DynamicResource CardBrush}"/>
      <Border IsHitTestVisible="False"
              CornerRadius="11"
              BorderThickness="1"
              BorderBrush="#3AFFFFFF"
              Margin="1"/>

      <Thumb x:Name="DragThumb"
             Grid.Row="0"
             Height="34"
             Cursor="SizeAll">
        <Thumb.Template>
          <ControlTemplate TargetType="Thumb">
            <Border Background="Transparent" Padding="14,8,36,4">
              <StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="SubtitleText"
                           Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,2,0,0"/>
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>

      <Button x:Name="MenuButton"
              Grid.Row="0"
              Width="26"
              Height="24"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,5,8,0"
              Background="Transparent"
              BorderThickness="0"
              Foreground="{DynamicResource TextMutedBrush}"
              ToolTip="卡片菜单"
              Content="⋯"/>

      <ContentPresenter Grid.Row="1"
                        Content="{Binding Content, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="12,4,12,12"/>

      <Thumb x:Name="ResizeThumb"
             Grid.Row="1"
             Width="18"
             Height="18"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Cursor="SizeNWSE">
        <Thumb.Template>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Path Data="M 2,16 L 16,2 M 8,16 L 16,8"
                    Stroke="#6B7280"
                    StrokeThickness="1.4"
                    StrokeEndLineCap="Round"/>
            </Grid>
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>
    </Grid>
  </Border>
</UserControl>
