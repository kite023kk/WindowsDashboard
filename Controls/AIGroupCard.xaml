<UserControl x:Class="WindowsDashboard.Controls.AIGroupCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
  <StackPanel>
    <TextBlock Text="AI 工具"
               FontSize="12"
               Foreground="{DynamicResource TextMutedBrush}"
               Margin="0,0,0,8"/>
    <Button x:Name="ClaudeButton" Tag="claude" Click="OnToolClick" Style="{StaticResource AiToolButton}" Content="Claude"/>
    <Button x:Name="CodexButton" Tag="codex" Click="OnToolClick" Style="{StaticResource AiToolButton}" Content="Codex"/>
    <Button x:Name="ChatGptButton" Tag="chatgpt" Click="OnToolClick" Style="{StaticResource AiToolButton}" Content="ChatGPT"/>
  </StackPanel>
</UserControl>
