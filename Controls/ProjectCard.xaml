<UserControl x:Class="WindowsDashboard.Controls.ProjectCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
  <StackPanel>
    <Button Click="OnOpen"
            Tag="C:\Projects"
            Background="Transparent"
            BorderThickness="0"
            HorizontalContentAlignment="Left"
            Padding="6,5"
            Cursor="Hand">
      <TextBlock FontSize="12"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}"
                 Text="▾ Project"/>
    </Button>
    <ItemsControl x:Name="FolderList">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Click="OnOpen"
                  Tag="{Binding Path}"
                  Background="Transparent"
                  BorderThickness="0"
                  HorizontalContentAlignment="Left"
                  Padding="22,5"
                  Cursor="Hand">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8B7;"
                         FontFamily="Segoe MDL2 Assets"
                         FontSize="12"
                         Foreground="{DynamicResource YellowBrush}"
                         Margin="0,0,6,0"/>
              <TextBlock Text="{Binding Name}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
