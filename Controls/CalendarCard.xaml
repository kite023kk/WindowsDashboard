<UserControl x:Class="WindowsDashboard.Controls.CalendarCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <UniformGrid x:Name="WeekHeader" Grid.Row="0" Rows="1" Columns="7" Margin="0,0,0,6"/>
    <Grid x:Name="CalendarGrid" Grid.Row="1"/>
  </Grid>
</UserControl>
