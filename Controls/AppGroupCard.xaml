<UserControl x:Class="WindowsDashboard.Controls.AppGroupCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="AppList"
                    AllowDrop="True"
                    DragOver="OnDragOver"
                    Drop="OnDrop"
                    PreviewMouseRightButtonUp="OnAppRightClick">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Click="OnAppClick"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    Padding="6"
                    Margin="0,1"
                    Cursor="Hand">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="7" Padding="8,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Image Grid.Column="0"
                             Source="{Binding Icon}"
                             Width="22"
                             Height="22"
                             Stretch="Uniform"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding DisplayPath}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2"
                                 Text="..."
                                 FontSize="12"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 VerticalAlignment="Center"
                                 Margin="6,0,0,0"/>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="BtnBorder" Property="Background" Value="#1FFFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="BtnBorder" Property="Opacity" Value="0.82"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Button x:Name="AddButton"
            Grid.Row="1"
            Click="OnAdd"
            HorizontalAlignment="Left"
            Background="Transparent"
            BorderThickness="0"
            Foreground="{DynamicResource TextMutedBrush}"
            FontSize="11"
            Padding="6,4"
            Content="+ 添加 / 拖入桌面快捷方式"
            Margin="2,4,0,0"
            Cursor="Hand"/>
  </Grid>
</UserControl>
