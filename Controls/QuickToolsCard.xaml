<UserControl x:Class="WindowsDashboard.Controls.QuickToolsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <ItemsControl x:Name="QuickGrid"
                  PreviewMouseRightButtonUp="OnToolRightClick">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="4"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Click="OnToolClick"
                  Background="#07FFFFFF"
                  BorderThickness="1"
                  BorderBrush="#12FFFFFF"
                  Margin="3"
                  Padding="4"
                  HorizontalContentAlignment="Center"
                  Cursor="Hand">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="TileBorder"
                        Background="#07FFFFFF"
                        BorderBrush="#12FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4,10">
                  <StackPanel>
                    <Image Source="{Binding Icon}"
                           Width="22"
                           Height="22"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TileBorder" Property="Background" Value="#14FFFFFF"/>
                    <Setter TargetName="TileBorder" Property="BorderBrush" Value="#24FFFFFF"/>
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="TileBorder" Property="Opacity" Value="0.78"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
