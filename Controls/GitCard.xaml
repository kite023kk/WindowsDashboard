<UserControl x:Class="WindowsDashboard.Controls.GitCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <ItemsControl x:Name="GitList"
                  PreviewMouseRightButtonUp="OnGitRightClick">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Click="OnGitClick"
                  Background="Transparent"
                  BorderThickness="0"
                  HorizontalContentAlignment="Stretch"
                  Margin="0,1"
                  Cursor="Hand">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="RowBorder" Background="Transparent" CornerRadius="8" Padding="8,7">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="30"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="26"
                            Height="26"
                            CornerRadius="7"
                            Background="#217FC39A"
                            BorderBrush="#337FC39A"
                            BorderThickness="1">
                      <TextBlock Text="G"
                                 Foreground="{DynamicResource GreenBrush}"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextBrush}"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Branch}"
                                 FontSize="10"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusText}"
                               Foreground="{Binding StatusBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="#0FFFFFFF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
